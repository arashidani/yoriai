generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(uuid(7))
  supabaseId            String                 @unique
  email                 String                 @unique
  name                  String?
  username              String?                @db.VarChar(100)
  role                  Role                   @default(USER)
  departmentId          String?
  department            Department?            @relation(fields: [departmentId], references: [id])
  businessAreaId        String?
  businessArea          BusinessArea?          @relation(fields: [businessAreaId], references: [id])
  joinedYear            Int?
  joinedMonth           Int?
  businessSkills        UserBusinessSkill[]
  interests             UserInterest[]
  lunchPreference       LunchPreference?
  recommendedLunchSpot  String?                @db.VarChar(20)
  bio                   String?                @db.VarChar(200)
  displayNameColor      DisplayNameColor?
  avatarUrl             String?
  onboardingCompletedAt DateTime?
  posts                 Post[]
  answers               Answer[]               @relation("AnswerAuthor")
  notifications         Notification[]
  hiddenAnswers         Answer[]               @relation("AnswerHiddenBy")
  postAnonymousProfiles PostAnonymousProfile[]
  questionLikes         QuestionLike[]
  answerLikes           AnswerLike[]
  postBookmarks         PostBookmark[]
  aiFlags               AiFlag[]
  hirobaPosts           HirobaPost[]
  hirobaAnswers         HirobaAnswer[]         @relation("HirobaAnswerAuthor")
  hirobaPostLikes       HirobaPostLike[]
  hirobaAnswerLikes     HirobaAnswerLike[]
  hirobaPostBookmarks   HirobaPostBookmark[]
  hirobaMemberships     HirobaMembership[]
  createdAt             DateTime               @default(now())
}

model Department {
  id        String   @id @default(uuid(7))
  name      String   @unique
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessArea {
  id        String   @id @default(uuid(7))
  name      String   @unique
  isActive  Boolean  @default(true)
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessSkill {
  id        String              @id @default(uuid(7))
  name      String              @unique
  isActive  Boolean             @default(true)
  users     UserBusinessSkill[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model Interest {
  id        String         @id @default(uuid(7))
  name      String         @unique
  isActive  Boolean        @default(true)
  users     UserInterest[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model UserBusinessSkill {
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessSkillId String
  businessSkill   BusinessSkill @relation(fields: [businessSkillId], references: [id], onDelete: Cascade)

  @@id([userId, businessSkillId])
}

model UserInterest {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestId String
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
}

model Post {
  id             String         @id @default(uuid(7))
  title          String
  body           String
  authorId       String?
  author         User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  idempotencyKey String?
  status         QuestionStatus @default(OPEN)
  answerCount    Int            @default(0)
  likeCount      Int            @default(0)
  resolvedAt     DateTime?

  /// このスレッド内で質問者本人に表示する匿名キャラの割り当て（作成直後は未設定のためnullable）
  postAnonymousProfileId      String?
  postAnonymousProfile        PostAnonymousProfile?  @relation("PostAuthorAssignment", fields: [postAnonymousProfileId], references: [id])
  /// このスレッドに紐づく全ユーザー分の匿名キャラ割り当て
  anonymousProfileAssignments PostAnonymousProfile[] @relation("PostAssignments")

  answers       Answer[]
  likes         QuestionLike[]
  bookmarks     PostBookmark[]
  aiFlags       AiFlag[]
  notifications Notification[]
  tags          PostTag[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  /// AIフラグによる自動ソフトデリート日時（管理者が復元するとnullに戻る）
  deletedAt DateTime?

  @@unique([authorId, idempotencyKey])
}

/// 質問スレッドごとの「実ユーザー ⇔ 匿名キャラ」の対応
model PostAnonymousProfile {
  id                 String           @id @default(uuid(7))
  postId             String
  post               Post             @relation("PostAssignments", fields: [postId], references: [id], onDelete: Cascade)
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  anonymousProfileId String
  anonymousProfile   AnonymousProfile @relation(fields: [anonymousProfileId], references: [id])
  createdAt          DateTime         @default(now())

  assignedAsAuthorOfPosts Post[]   @relation("PostAuthorAssignment")
  answers                 Answer[]

  @@unique([postId, userId])
  @@unique([postId, anonymousProfileId])
}

/// 匿名キャラのマスタ（表示名・アイコン）
model AnonymousProfile {
  id          String   @id @default(uuid(7))
  displayName String   @unique
  avatarUrl   String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  assignments PostAnonymousProfile[]
}

/// 質問（Post）に対する回答
model Answer {
  id     String @id @default(uuid(7))
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("AnswerAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  /// スレッド内で表示する匿名キャラの割り当て
  postAnonymousProfileId String
  postAnonymousProfile   PostAnonymousProfile @relation(fields: [postAnonymousProfileId], references: [id])

  body String

  isHidden       Boolean   @default(false)
  hiddenAt       DateTime?
  hiddenByUserId String?
  hiddenByUser   User?     @relation("AnswerHiddenBy", fields: [hiddenByUserId], references: [id], onDelete: SetNull)
  hiddenReason   String?

  likeCount Int @default(0)

  idempotencyKey String?

  likes         AnswerLike[]
  aiFlags       AiFlag[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([authorId, idempotencyKey])
}

model Notification {
  id        String           @id @default(uuid(7))
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  postId    String?
  post      Post?            @relation(fields: [postId], references: [id], onDelete: Cascade)
  answerId  String?
  answer    Answer?          @relation(fields: [answerId], references: [id], onDelete: Cascade)
  hirobaPostId String?
  hirobaPost HirobaPost? @relation("NotificationHirobaPost", fields: [hirobaPostId], references: [id], onDelete: Cascade)
  hirobaAnswerId String?
  hirobaAnswer HirobaAnswer? @relation("NotificationHirobaAnswer", fields: [hirobaAnswerId], references: [id], onDelete: Cascade)
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
}

model QuestionLike {
  id        String   @id @default(uuid(7))
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model AnswerLike {
  id        String   @id @default(uuid(7))
  answerId  String
  answer    Answer   @relation(fields: [answerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([answerId, userId])
}

model PostBookmark {
  id        String   @id @default(uuid(7))
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Badge {
  id          String      @id @default(uuid(7))
  name        String
  description String
  icon        String
  rarity      BadgeRarity
  earnedCount Int         @default(0)
  missions    Mission[]
  createdAt   DateTime    @default(now())
}

model Mission {
  id                String   @id @default(uuid(7))
  name              String
  description       String
  durationLabel     String
  targetCount       Int
  active            Boolean  @default(true)
  participantsCount Int      @default(0)
  progressPercent   Int      @default(0)
  rewardBadgeId     String?
  rewardBadge       Badge?   @relation(fields: [rewardBadgeId], references: [id], onDelete: SetNull)
  createdAt         DateTime @default(now())
}

model AiFlag {
  id             String        @id @default(uuid(7))
  title          String
  detail         String
  severity       FlagSeverity
  status         FlagStatus    @default(UNREAD)
  targetUserId   String?
  targetUser     User?         @relation(fields: [targetUserId], references: [id], onDelete: SetNull)
  postId         String?
  post           Post?         @relation(fields: [postId], references: [id], onDelete: Cascade)
  answerId       String?
  answer         Answer?       @relation(fields: [answerId], references: [id], onDelete: Cascade)
  hirobaPostId   String?
  hirobaPost     HirobaPost?   @relation(fields: [hirobaPostId], references: [id], onDelete: Cascade)
  hirobaAnswerId String?
  hirobaAnswer   HirobaAnswer? @relation(fields: [hirobaAnswerId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
}

/// タグのマスタ（管理者が管理パネルで維持し、投稿にはAIが自動付与する。ユーザーは付与・変更不可）
model Tag {
  id                 String          @id @default(uuid(7))
  name               String          @unique
  category           String
  categoryDefinition TagCategory     @relation(fields: [category], references: [name], onDelete: Restrict, onUpdate: Cascade)
  description        String?
  isWorkTag          Boolean         @default(false)
  posts              PostTag[]
  hirobaPosts        HirobaPostTag[]
  createdAt          DateTime        @default(now())
}

/// タグカテゴリーのマスタ。管理者が管理し、Tag.categoryの選択肢になる
model TagCategory {
  id        String   @id @default(uuid(7))
  name      String   @unique
  tags      Tag[]
  createdAt DateTime @default(now())
}

/// 投稿とタグの中間テーブル（AI自動付与、1投稿あたり最大3件）
model PostTag {
  id        String   @id @default(uuid(7))
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, tagId])
}

/// ひろば（サブフォーラム）の固定マスタ
model Hiroba {
  id          String             @id @default(uuid(7))
  slug        String             @unique
  name        String
  description String
  posts       HirobaPost[]
  memberships HirobaMembership[]
  createdAt   DateTime           @default(now())
}

/// ユーザーが参加しているひろば
model HirobaMembership {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hirobaId  String
  hiroba    Hiroba   @relation(fields: [hirobaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, hirobaId])
}

/// ひろば内の投稿。QA投稿と異なり匿名化は行わない
model HirobaPost {
  id       String  @id @default(uuid(7))
  hirobaId String
  hiroba   Hiroba  @relation(fields: [hirobaId], references: [id], onDelete: Cascade)
  title    String
  body     String
  imageUrl String?
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  idempotencyKey String?
  answerCount    Int     @default(0)
  likeCount      Int     @default(0)

  answers   HirobaAnswer[]
  likes     HirobaPostLike[]
  bookmarks HirobaPostBookmark[]
  aiFlags   AiFlag[]
  tags      HirobaPostTag[]
  notifications Notification[] @relation("NotificationHirobaPost")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  /// AIフラグによる自動ソフトデリート日時
  deletedAt DateTime?

  @@unique([authorId, idempotencyKey])
}

/// ひろば投稿への回答。実名で表示する
model HirobaAnswer {
  id           String     @id @default(uuid(7))
  hirobaPostId String
  hirobaPost   HirobaPost @relation(fields: [hirobaPostId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("HirobaAnswerAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  body String

  isHidden     Boolean   @default(false)
  hiddenAt     DateTime?
  hiddenReason String?

  likeCount      Int     @default(0)
  idempotencyKey String?

  likes     HirobaAnswerLike[]
  aiFlags   AiFlag[]
  notifications Notification[] @relation("NotificationHirobaAnswer")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([authorId, idempotencyKey])
}

model HirobaPostLike {
  id           String     @id @default(uuid(7))
  hirobaPostId String
  hirobaPost   HirobaPost @relation(fields: [hirobaPostId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([hirobaPostId, userId])
}

model HirobaAnswerLike {
  id             String       @id @default(uuid(7))
  hirobaAnswerId String
  hirobaAnswer   HirobaAnswer @relation(fields: [hirobaAnswerId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([hirobaAnswerId, userId])
}

model HirobaPostBookmark {
  id           String     @id @default(uuid(7))
  hirobaPostId String
  hirobaPost   HirobaPost @relation(fields: [hirobaPostId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([hirobaPostId, userId])
}

/// ひろば投稿とタグの中間テーブル（Tagマスタを共用、AI自動付与）
model HirobaPostTag {
  id           String     @id @default(uuid(7))
  hirobaPostId String
  hirobaPost   HirobaPost @relation(fields: [hirobaPostId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([hirobaPostId, tagId])
}

model Invite {
  id        String    @id @default(uuid(7))
  token     String    @unique
  name      String?
  role      Role      @default(USER)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model PasswordReset {
  id        String    @id @default(uuid(7))
  token     String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum Role {
  USER
  ADMIN
}

enum LunchPreference {
  NO_PREFERENCE
  TEAM
  ALONE
}

enum DisplayNameColor {
  GREEN
  YELLOW
  BLUE
  PURPLE
  GRAY
}

enum BadgeRarity {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum FlagSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FlagStatus {
  UNREAD
  CONFIRMED
}

enum QuestionStatus {
  OPEN
  RESOLVED
  HIDDEN
}

enum NotificationType {
  POST_ANSWERED
  POST_LIKED
  ANSWER_LIKED
  HIROBA_POST_ANSWERED
  HIROBA_POST_LIKED
  HIROBA_ANSWER_LIKED
  POST_DELETED
  ANSWER_HIDDEN
}
